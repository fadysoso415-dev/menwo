rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Matches collection
    match /matches/{matchId} {
      allow read, write: if true;
    }

    // Bets collection
    match /bets/{betId} {
      allow read, write: if true;
    }

    // Deposit Requests
    match /depositRequests/{requestId} {
      allow read, write: if true;
    }

    // Withdrawal Requests
    match /withdrawalRequests/{requestId} {
      allow read, write: if true;
    }

    // Public Bet Offers
    match /publicBetOffers/{offerId} {
      allow read, write: if true;
    }

    // Connection test document
    match /_connection_test/{docId} {
      allow read, write: if true;
    }
  }
}

